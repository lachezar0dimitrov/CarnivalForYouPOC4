VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Optional — when
# unset, src/lib/analytics.ts is a no-op and the cookie banner's "Accept"
# does nothing beyond recording the choice.
VITE_GA_MEASUREMENT_ID=

# Cloudflare R2 (used server-side only, by supabase/functions/r2-media —
# never read by client code, so no VITE_ prefix)
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
